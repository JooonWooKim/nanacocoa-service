#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
COMMAND_DIR="$SCRIPT_DIR/harness.d"

usage() {
	cat <<'EOF'
사용법: ./scripts/harness <명령>

핵심 명령:
  help              명령 지도를 표시합니다
  doctor            비밀값을 읽지 않고 로컬 선행 조건을 진단합니다
  bootstrap         안전한 로컬 환경 준비 단계를 안내합니다
  check             기준선 래칫이 있는 로컬·CI 품질 계약을 실행합니다
  test              전체 Gradle 테스트를 엄격하게 실행합니다
  test-unit         집중 단위·Service 테스트를 실행합니다
  test-integration  애플리케이션·마이그레이션 통합 테스트를 엄격하게 실행합니다
  architecture      의존성과 계층 불변식을 강제합니다
  docs              지식 구조, 링크, 생성 문서 drift를 검사합니다
  eval              현재 테스트 증거로 핵심 위험을 평가합니다
  smoke             Compose와 이미 실행 중인 app을 검사합니다
  evidence          비식별화된 상태·증거 묶음을 수집합니다
  clean             build/harness 임시 결과만 삭제합니다

유지보수 명령:
  security          저장소 소유 텍스트·스크립트의 위험 패턴을 검사합니다
  migrations        불변 마이그레이션 checksum을 검증합니다
  migrations --accept-new
                    새로 추가된 Flyway 마이그레이션만 등록합니다
  generate-docs     저장소·스키마 참조 문서를 재생성합니다
  entropy           파일을 변경하지 않는 drift·부채 진단을 생성합니다
  test-baseline     전체 테스트와 정확한 알려진 실패 래칫을 실행합니다

알려진 제품 실패가 있는 동안 엄격한 `test`는 실패합니다. `check`는 정확한
검토 완료 집합을 BASELINED로 표시하며 해당 집합이 변경되면 실패합니다.
EOF
}

command=${1:-help}
if [ "$#" -gt 0 ]; then
	shift
fi

case "$command" in
	help|-h|--help)
		if [ "$#" -ne 0 ]; then
			echo "FAIL: help는 인자를 받지 않습니다: $*" >&2
			exit 64
		fi
		usage
		;;
	doctor|bootstrap|check|architecture|docs|eval|smoke|evidence|clean|security|entropy)
		if [ "$#" -ne 0 ]; then
			echo "FAIL: $command 명령은 인자를 받지 않습니다: $*" >&2
			exit 64
		fi
		exec "$COMMAND_DIR/$command.sh"
		;;
	migrations)
		if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--accept-new" ]; }; then
			echo "FAIL: migrations는 --accept-new만 허용합니다" >&2
			exit 64
		fi
		exec "$COMMAND_DIR/$command.sh" "$@"
		;;
	generate-docs)
		if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--check" ]; }; then
			echo "FAIL: generate-docs는 --check만 허용합니다" >&2
			exit 64
		fi
		exec "$COMMAND_DIR/$command.sh" "$@"
		;;
	test-baseline)
		if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--from-results" ]; }; then
			echo "FAIL: test-baseline은 --from-results만 허용합니다" >&2
			exit 64
		fi
		exec "$COMMAND_DIR/$command.sh" "$@"
		;;
	test)
		cd "$SCRIPT_DIR/.."
		exec ./gradlew test "$@"
		;;
	test-unit)
		cd "$SCRIPT_DIR/.."
		exec ./gradlew test \
			--tests 'com.nanacocoa.server.order.*' \
			--tests 'com.nanacocoa.server.payment.*' \
			--tests 'com.nanacocoa.server.products.*' "$@"
		;;
	test-integration)
		cd "$SCRIPT_DIR/.."
		exec ./gradlew test \
			--tests 'com.nanacocoa.server.NanacocoaServerApplicationTests' \
			--tests 'com.nanacocoa.server.migration.*' "$@"
		;;
	*)
		echo "FAIL: 알 수 없는 하네스 명령: $command" >&2
		echo "지원 명령은 ./scripts/harness help로 확인하세요." >&2
		exit 64
		;;
esac
